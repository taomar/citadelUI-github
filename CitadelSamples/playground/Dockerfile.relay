# Build from CitadelSamples: docker build -f playground/Dockerfile.relay .
FROM node:20-alpine

WORKDIR /app
COPY playground/relay-server.mjs ./
COPY playground/src/catalogue ./src/catalogue
COPY playground/src/core ./src/core
COPY playground/src/relay ./src/relay
COPY playground/src/server/assertions.mjs ./src/server/assertions.mjs
COPY playground/src/server/redaction.mjs ./src/server/redaction.mjs
COPY playground/src/server/runRequest.mjs ./src/server/runRequest.mjs

ENV NODE_ENV=production \
    CITADEL_RELAY_PORT=8080 \
    CITADEL_RELAY_HOST=0.0.0.0

USER node
EXPOSE 8080
CMD ["node", "relay-server.mjs"]
