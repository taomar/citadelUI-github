{
  "name": "citadel-publish-playground",
  "version": "1.0.0",
  "private": true,
  "description": "Zero-build guided playground for the Citadel publish-contract validation notebook.",
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "start:hosted": "node hosted-server.mjs",
    "start:execute": "node server.mjs --execute",
    "start:execute:system-login": "node server.mjs --execute --allow-system-azure-login",
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "check:playground-app": "node scripts/check-playground-app-registration.mjs",
    "check:relay-app": "node scripts/check-relay-app-registration.mjs",
    "smoke": "node scripts/smoke.mjs",
    "acceptance:dossier": "node scripts/dossier-browser-acceptance.mjs",
    "verify": "node scripts/check.mjs && node --test && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@azure/msal-node": "6.0.0",
    "jose": "6.2.12"
  },
  "devDependencies": {}
}
