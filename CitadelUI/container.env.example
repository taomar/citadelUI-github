# Persistent host directory for backups, audit, settings, and recovery journals.
CITADEL_DATA_PATH=./.data

# Override only with an approved, digest-pinned release image.
CITADEL_IMAGE=citadel-ui:local

# Release builds pin this to an approved Node image digest.
CITADEL_NODE_IMAGE=node:22.14.0-bookworm-slim@sha256:1c18d9ab3af4585870b92e4dbc5cac5a0dc77dd13df1a5905cea89fc720eb05b
